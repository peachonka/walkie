            "exec": [
              "pm.test(\"Walk started successfully\", function () {\r\n    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r\n});\r\n\r\nconst response = pm.response.json();\r\n\r\npm.test(\"Walk ID is returned\", function () {\r\n    pm.expect(response.walk_id).to.exist;\r\n});\r\n\r\npm.test(\"Start time is returned\", function () {\r\n    pm.expect(response.start_time).to.exist;\r\n});\r\n\r\nif (response.walk_id) {\r\n    pm.environment.set(\"walkId\", response.walk_id);\r\n}"
            ]
