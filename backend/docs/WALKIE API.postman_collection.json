    {
      "name": "Стоп прогулки A",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Walk completed successfully\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst response = pm.response.json();\r\n\r\npm.test(\"Walk ID is returned\", function () {\r\n    pm.expect(response.walk_id).to.exist;\r\n});\r\n\r\npm.test(\"Walk ID matches requested ID\", function () {\r\n    pm.expect(String(response.walk_id)).to.eql(\r\n        String(pm.environment.get(\"walkId\"))\r\n    );\r\n});\r\n\r\npm.test(\"Distance is returned\", function () {\r\n    pm.expect(response.distance).to.exist;\r\n});\r\n\r\npm.test(\"Duration is returned\", function () {\r\n    pm.expect(response.duration).to.exist;\r\n});\r\n\r\npm.test(\"Steps are returned\", function () {\r\n    pm.expect(response.steps).to.exist;\r\n});\r\n\r\npm.test(\"Items array is returned\", function () {\r\n    pm.expect(response.items_collected).to.be.an(\"array\");\r\n});\r\n\r\npm.test(\"Achievements array is returned\", function () {\r\n    pm.expect(response.new_achievements).to.be.an(\"array\");\r\n});\r\n\r\npm.test(\"Pet information is returned\", function () {\r\n    pm.expect(response.pet).to.exist;\r\n});\r\n\r\nif (response.pet) {\r\n    pm.test(\"Pet received experience\", function () {\r\n        pm.expect(response.pet.earned_exp).to.be.above(0);\r\n    });\r\n\r\n    pm.test(\"Pet level and exp are returned\", function () {\r\n        pm.expect(response.pet).to.have.property(\"level\");\r\n        pm.expect(response.pet).to.have.property(\"exp\");\r\n    });\r\n}"
            ]
          }
        }
