    {
      "name": "Создание питомца",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Pet created with status 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\nconst response = pm.response.json();\r\n\r\npm.test(\"Success flag is true\", function () {\r\n    pm.expect(response.success).to.eql(true);\r\n});\r\n\r\npm.test(\"Pet object is returned\", function () {\r\n    pm.expect(response.pet).to.be.an(\"object\");\r\n});\r\n\r\npm.test(\"Pet has required fields\", function () {\r\n    pm.expect(response.pet).to.have.property(\"id\");\r\n    pm.expect(response.pet).to.have.property(\"user_id\");\r\n    pm.expect(response.pet).to.have.property(\"pet_id\");\r\n    pm.expect(response.pet).to.have.property(\"name\");\r\n    pm.expect(response.pet).to.have.property(\"level\");\r\n    pm.expect(response.pet).to.have.property(\"exp\");\r\n});\r\n\r\npm.test(\"Pet starts at level 1 with 0 exp\", function () {\r\n    pm.expect(response.pet.level).to.eql(1);\r\n    pm.expect(response.pet.exp).to.eql(0);\r\n});"
            ]
          }
        }
