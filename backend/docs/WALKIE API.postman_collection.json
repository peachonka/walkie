            "type": "text/javascript",
            "exec": [
              "pm.test(\"Pet retrieved successfully\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst response = pm.response.json();\r\n\r\npm.test(\"Pet has required fields\", function () {\r\n    pm.expect(response).to.have.property(\"id\");\r\n    pm.expect(response).to.have.property(\"name\");\r\n    pm.expect(response).to.have.property(\"type\");\r\n    pm.expect(response).to.have.property(\"avatar\");\r\n    pm.expect(response).to.have.property(\"level\");\r\n    pm.expect(response).to.have.property(\"exp\");\r\n    pm.expect(response).to.have.property(\"exp_to_next_level\");\r\n});\r\n\r\npm.test(\"Pet level is positive\", function () {\r\n    pm.expect(response.level).to.be.above(0);\r\n});\r\n\r\npm.test(\"Pet experience is non-negative\", function () {\r\n    pm.expect(response.exp).to.be.at.least(0);\r\n});\r\n\r\npm.test(\"Experience threshold is positive\", function () {\r\n    pm.expect(response.exp_to_next_level).to.be.above(0);\r\n});"
